import {
  Image,
  Modal,
  Pressable,
  ScrollView,
  StyleSheet,
  Text,
  View,
  useWindowDimensions,
} from 'react-native';
import { useSafeAreaInsets } from 'react-native-safe-area-context';

import type { Product } from '../data/menu';
import { productImages } from '../data/productImages';
import {
  colors,
  fonts,
  spacing,
} from '../theme';
import { rubles } from '../utils';

export default function ProductSheet({
  product,
  selectedSize,
  altMilk,
  syrup,
  onSizeChange,
  onAltMilkChange,
  onSyrupChange,
  onClose,
  onAdd,
}: {
  product: Product | null;
  selectedSize: number;
  altMilk: boolean;
  syrup: boolean;
  onSizeChange: (index: number) => void;
  onAltMilkChange: () => void;
  onSyrupChange: () => void;
  onClose: () => void;
  onAdd: () => void;
}) {
  const insets = useSafeAreaInsets();
  const { width: viewportWidth, height: viewportHeight } =
    useWindowDimensions();

  const compactProductLayout =
    viewportHeight < 760 || viewportWidth < 360;

  const total = product
    ? product.sizes[selectedSize].price +
      (altMilk ? 90 : 0) +
      (syrup ? 30 : 0)
    : 0;

  if (!product) {
    return null;
  }

  const pageColor =
    product.category === 'classic' ||
    product.category === 'not-coffee'
      ? colors.aqua
      : colors.red;

  return (
    <Modal
      visible
      animationType="slide"
      presentationStyle="fullScreen"
      onRequestClose={onClose}
    >
      <View
        style={[
          s.page,
          {
            backgroundColor: pageColor,
            paddingTop: insets.top,
          },
        ]}
      >
        <View style={s.topBar}>
          <Pressable
            accessibilityLabel="Закрыть"
            onPress={onClose}
            hitSlop={10}
            style={s.close}
          >
            <Text style={s.closeText}>×</Text>
          </Pressable>

          <Text style={s.topLabel}>SMALL TALK</Text>
        </View>

        <ScrollView
          style={s.scroll}
          showsVerticalScrollIndicator={false}
          contentInsetAdjustmentBehavior="never"
          contentContainerStyle={[
            s.scrollContent,
            compactProductLayout &&
              s.scrollContentCompact,
            { paddingBottom: compactProductLayout ? 16 : 24 },
          ]}
        >
          <View
            style={[
              s.visualWrap,
              compactProductLayout &&
                s.visualWrapCompact,
            ]}
          >
            <Image
              source={productImages[product.id]}
              resizeMode="contain"
              style={s.visualImage}
            />
          </View>

          <Text
            style={[
              s.title,
              compactProductLayout &&
                s.titleCompact,
            ]}
          >
            {product.name}
          </Text>

          <View
            style={[
              s.rule,
              compactProductLayout &&
                s.ruleCompact,
            ]}
          />

          <View
            style={[
              s.infoBlock,
              compactProductLayout &&
                s.infoBlockCompact,
            ]}
          >
            <Text style={s.sectionLabel}>
              РАЗМЕР
            </Text>

            <View
              style={[
                s.sizeList,
                compactProductLayout &&
                  s.sizeListCompact,
              ]}
            >
              {product.sizes.map((size, index) => {
                const active =
                  index === selectedSize;

                return (
                  <Pressable
                    key={size.label}
                    onPress={() =>
                      onSizeChange(index)
                    }
                    style={[
                      s.option,
                      compactProductLayout &&
                        s.optionCompact,
                      active && s.optionActive,
                    ]}
                  >
                    <Text
                      style={[
                        s.optionMain,
                        active &&
                          s.optionMainActive,
                      ]}
                    >
                      {size.label}
                    </Text>

                    <Text
                      style={[
                        s.optionPrice,
                        active &&
                          s.optionPriceActive,
                      ]}
                    >
                      {rubles(size.price)}
                    </Text>
                  </Pressable>
                );
              })}
            </View>
          </View>

<View
            style={[
              s.infoBlock,
              compactProductLayout &&
                s.infoBlockCompact,
            ]}
          >
            <Text style={s.sectionLabel}>
              ДОБАВИТЬ
            </Text>

            <View style={s.extraGrid}>
              <Pressable
                onPress={onAltMilkChange}
                style={[
                  s.extraButton,
                  altMilk && s.extraButtonActive,
                  compactProductLayout &&
                    s.extraButtonCompact,
                ]}
              >
                <Text
                  style={[
                    s.extraButtonTitle,
                    altMilk &&
                      s.extraButtonTitleActive,
                  ]}
                >
                  альт. молоко
                </Text>

                <Text
                  style={[
                    s.extraButtonHint,
                    altMilk &&
                      s.extraButtonHintActive,
                  ]}
                >
                  овсяное / кокосовое
                </Text>

                <Text
                  style={[
                    s.extraButtonPrice,
                    altMilk &&
                      s.extraButtonPriceActive,
                  ]}
                >
                  {altMilk ? '✓ выбрано' : '+90 ₽'}
                </Text>
              </Pressable>

              <Pressable
                onPress={onSyrupChange}
                style={[
                  s.extraButton,
                  syrup && s.extraButtonActive,
                  compactProductLayout &&
                    s.extraButtonCompact,
                ]}
              >
                <Text
                  style={[
                    s.extraButtonTitle,
                    syrup &&
                      s.extraButtonTitleActive,
                  ]}
                >
                  сироп
                </Text>

                <Text
                  style={[
                    s.extraButtonHint,
                    syrup &&
                      s.extraButtonHintActive,
                  ]}
                >
                  ваниль / карамель
                </Text>

                <Text
                  style={[
                    s.extraButtonPrice,
                    syrup &&
                      s.extraButtonPriceActive,
                  ]}
                >
                  {syrup ? '✓ выбрано' : '+30 ₽'}
                </Text>
              </Pressable>
            </View>
          </View>

<View
            style={[
              s.infoBlock,
              compactProductLayout &&
                s.infoBlockCompact,
            ]}
          >
            <Text style={s.sectionLabel}>
              СОСТАВ
            </Text>

            <Text style={s.description}>
              {product.description}
            </Text>
          </View>
        </ScrollView>

        <View
          style={[
            s.bottomBar,
            {
              paddingBottom:
                Math.max(insets.bottom, 10),
              backgroundColor: pageColor,
            },
          ]}
        >
          <Pressable
            onPress={onAdd}
            style={s.cta}
          >
            <Text style={s.ctaText}>
              в корзину
            </Text>
            <Text style={s.ctaText}>
              {rubles(total)}
            </Text>
          </Pressable>
        </View>
      </View>
    </Modal>
  );
}

