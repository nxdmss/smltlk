import {
  Image,
  Modal,
  Pressable,
  ScrollView,
  StyleSheet,
  Text,
  View,
} from 'react-native';
import { useSafeAreaInsets } from 'react-native-safe-area-context';

import type { Product } from '../data/menu';
import { productImages } from '../data/productImages';
import {
  colors,
  fonts,
  spacing,
} from '../theme';
import { rubles } from '../utils';

export default function ProductSheet({
  product,
  selectedSize,
  altMilk,
  syrup,
  onSizeChange,
  onAltMilkChange,
  onSyrupChange,
  onClose,
  onAdd,
}: {
  product: Product | null;
  selectedSize: number;
  altMilk: boolean;
  syrup: boolean;
  onSizeChange: (index: number) => void;
  onAltMilkChange: () => void;
  onSyrupChange: () => void;
  onClose: () => void;
  onAdd: () => void;
}) {
  const insets = useSafeAreaInsets();

  const total = product
    ? product.sizes[selectedSize].price +
      (altMilk ? 90 : 0) +
      (syrup ? 30 : 0)
    : 0;

  if (!product) {
    return null;
  }

  const pageColor =
    product.category === 'classic' ||
    product.category === 'not-coffee'
      ? colors.aqua
      : colors.red;

  return (
    <Modal
      visible
      animationType="slide"
      presentationStyle="fullScreen"
      onRequestClose={onClose}
    >
      <View
        style={[
          s.page,
          {
            backgroundColor: pageColor,
            paddingTop: insets.top,
          },
        ]}
      >
        <View style={s.topBar}>
          <Pressable
            accessibilityLabel="Закрыть"
            onPress={onClose}
            hitSlop={10}
            style={s.close}
          >
            <Text style={s.closeText}>×</Text>
          </Pressable>

          <Text style={s.topLabel}>SMALL TALK</Text>
        </View>

        <ScrollView
          showsVerticalScrollIndicator={false}
          contentContainerStyle={[
            s.scrollContent,
            {
              paddingBottom: 126 + insets.bottom,
            },
          ]}
        >
          <View style={s.visualWrap}>
            <Image
              source={productImages[product.id]}
              resizeMode="contain"
              style={s.visualImage}
            />
          </View>

          <Text style={s.title}>
            {product.name}
          </Text>

          <View style={s.rule} />

          <View style={s.infoBlock}>
            <Text style={s.sectionLabel}>
              СОСТАВ
            </Text>

            <Text style={s.description}>
              {product.description}
            </Text>
          </View>

          <View style={s.infoBlock}>
            <Text style={s.sectionLabel}>
              РАЗМЕР
            </Text>

            <View style={s.sizeList}>
              {product.sizes.map((size, index) => {
                const active =
                  index === selectedSize;

                return (
                  <Pressable
                    key={size.label}
                    onPress={() =>
                      onSizeChange(index)
                    }
                    style={[
                      s.option,
                      active && s.optionActive,
                    ]}
                  >
                    <Text
                      style={[
                        s.optionMain,
                        active &&
                          s.optionMainActive,
                      ]}
                    >
                      {size.label}
                    </Text>

                    <Text
                      style={[
                        s.optionPrice,
                        active &&
                          s.optionPriceActive,
                      ]}
                    >
                      {rubles(size.price)}
                    </Text>
                  </Pressable>
                );
              })}
            </View>
          </View>

          <View style={s.infoBlock}>
            <Text style={s.sectionLabel}>
              ДОБАВИТЬ
            </Text>

            <Pressable
              onPress={onAltMilkChange}
              style={[
                s.extra,
                altMilk && s.extraActive,
              ]}
            >
              <View style={s.extraCopy}>
                <Text
                  style={[
                    s.extraTitle,
                    altMilk &&
                      s.extraTitleActive,
                  ]}
                >
                  альтернативное молоко
                </Text>
                <Text
                  style={[
                    s.extraHint,
                    altMilk &&
                      s.extraHintActive,
                  ]}
                >
                  овсяное / кокосовое
                </Text>
              </View>

              <Text
                style={[
                  s.extraPrice,
                  altMilk &&
                    s.extraPriceActive,
                ]}
              >
                {altMilk ? '✓' : '+90 ₽'}
              </Text>
            </Pressable>

            <Pressable
              onPress={onSyrupChange}
              style={[
                s.extra,
                syrup && s.extraActive,
              ]}
            >
              <View style={s.extraCopy}>
                <Text
                  style={[
                    s.extraTitle,
                    syrup &&
                      s.extraTitleActive,
                  ]}
                >
                  сироп
                </Text>
                <Text
                  style={[
                    s.extraHint,
                    syrup &&
                      s.extraHintActive,
                  ]}
                >
                  ваниль / карамель
                </Text>
              </View>

              <Text
                style={[
                  s.extraPrice,
                  syrup &&
                    s.extraPriceActive,
                ]}
              >
                {syrup ? '✓' : '+30 ₽'}
              </Text>
            </Pressable>
          </View>
        </ScrollView>

        <View
          style={[
            s.bottomBar,
            {
              paddingBottom:
                Math.max(insets.bottom, 10),
              backgroundColor: pageColor,
            },
          ]}
        >
          <Pressable
            onPress={onAdd}
            style={s.cta}
          >
            <Text style={s.ctaText}>
              в корзину
            </Text>
            <Text style={s.ctaText}>
              {rubles(total)}
            </Text>
          </Pressable>
        </View>
      </View>
    </Modal>
  );
}

